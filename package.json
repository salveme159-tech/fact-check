{
  "name": "dart-navigator-factcheck",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "기사 속 기업·기간·수치·부호를 DART 공시와 대조하는 팩트 체크 전용 앱",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:pages": "vite build",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/test-article-claims.mjs scripts/test-article-clarity.mjs scripts/test-article-api.mjs scripts/test-article-backlog.mjs"
  },
  "dependencies": {
    "@trpc/server": "^11.6.0",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "superjson": "^1.13.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vite": "^7.1.7"
  },
  "packageManager": "pnpm@10.18.0"
}
